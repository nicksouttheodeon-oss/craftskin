  "controls": {
    "transport_align": "center",
    "transport_position": "above_scrub",
    "timeline_toolbar": "normal",
    "transport_order": [
      "playhead.stepBack",
      "playback.toggle",
      "playhead.stepForward",
      "markers.goToIn",
      "markers.goToOut"
    ],
    "timeline_toolbar_position": "above_timecode"
  }
